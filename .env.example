# 이 파일을 복사해서 .env 로 만든 뒤 값을 채우세요.
# (복사 방법: .env.example 을 복사 → 이름을 .env 로 변경)

GEMINI_API_KEY=여기에_제미니_API키
GEMINI_MODEL=gemini-3.8-flash

G_CLIENT_ID=여기에_클라이언트_ID
G_CLIENT_SECRET=여기에_클라이언트_시크릿
G_REFRESH_TOKEN=여기에_리프레시_토큰

BLOGGER_BLOG_ID=여기에_블로그_ID

# A모드(쉬운 모드): false=자동 공개 / true=초안만
POST_AS_DRAFT=false

# 블로그 주제 축 (한 가지만 유지하세요)
BLOG_NICHE=생활정보와 실용 가이드

# topics = topics_ko.txt만 / news = 한국뉴스만 / mixed = 둘 다
TOPIC_SOURCE=mixed
